# Local backend environment template. Copy to .env and replace the development secret.
DATABASE_URL=sqlite:///./data/herebuy.db
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080
APP_ENV=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
FIREBASE_CREDENTIALS_PATH=
